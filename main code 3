    <div class="modal-overlay" id="confirmModal">
        <div class="modal-card" style="max-width: 380px; text-align: center;">
            <div class="panel-title" style="justify-content: center;">Purge Ledger Archives</div>
            <p style="font-size: 0.95rem; color: var(--ink-muted); line-height: 1.6;">
                This action will wipe every single inscribed record from your vault. Confirm execution below.
            </p>
            <div style="display: flex; gap: 12px; margin-top: 10px;">
                <button type="button" class="vintage-btn danger" id="confirmPurgeBtn" style="flex: 1;">Purge All</button>
                <button type="button" class="vintage-btn" id="cancelPurgeBtn" style="flex: 1;">Cancel</button>
            </div>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        const STORAGE_KEY = 'vintage_ledger_records_v11';
        let registryData = [];
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) registryData = JSON.parse(raw);
        } catch (e) {
            registryData = [];
        }
        let currentType = 'income';

        function determineAICategory(text, type) {
            const raw = (text || '').toLowerCase().trim();

            if (type === 'income') {
                if (/wage|salary|labor|carpenter|joiner|smith|mason|clerk|overtime|work|job|pay|craft/i.test(raw)) {
                    return 'Labor & Wages';
                }
                if (/dividend|stock|share|interest|bond|railway|investment|vault|fund/i.test(raw)) {
                    return 'Investments & Dividends';
                }
                if (/rent|tenant|estate|property|lease|lodger/i.test(raw)) {
                    return 'Property & Rents';
                }
                if (/sale|merchant|trade|commerce|wares|goods|market/i.test(raw)) {
                    return 'Trade & Commerce';
                }
                return 'General Inflow';
            } else {
                if (/food|provision|bread|flour|tea|coffee|meat|butcher|grocer|ale|wine|feast|supper|dinner|milk|lard|sugar/i.test(raw)) {
                    return 'Provisions & Sustenance';
                }
                if (/rent|lodging|hearth|coal|wood|firewood|candle|oil|lamp|chimney|roof|house/i.test(raw)) {
                    return 'Lodging & Hearth';
                }
                if (/coat|tailor|apparel|boots|cobbler|shoe|dress|hat|silk|linen|wool|trousers|fabric/i.test(raw)) {
                    return 'Apparel & Tailoring';
                }
                if (/apothecary|tonic|medicine|elixir|physician|doctor|liniment|pill|health|chemist/i.test(raw)) {
                    return 'Apothecary & Health';
                }
                if (/coach|carriage|horse|cab|fare|train|railway|fare|travel|ticket|steamer|journey/i.test(raw)) {
                    return 'Coach & Transport';
                }
                if (/theatre|opera|cigar|tobacco|pipe|gambling|whist|novel|spirit|whiskey|luxury|jewel/i.test(raw)) {
                    return 'Leisure & Luxuries';
                }
                return 'General Outflow';
            }
        }

        function pickRandom(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function generateAICommentary(data) {
            const verdictEl = document.getElementById('aiVerdictBadge');
            const commentEl = document.getElementById('aiCommentaryText');
            if (!verdictEl || !commentEl) return;

            if (!data || data.length === 0) {
                const emptyDialogues = [
                    'The ledger remains blank and silent. Inscribe your coin and provisions so the Comptroller may render swift audit.',
                    'Not a single copper recorded in the vault. Dip your quill in ink and present your accounts for inspection.',
                    'A quiet ledger is the luxury of monarchs or vagabonds. Disclose your silver flow to initiate the counting house audit.',
                    'The inkwell sits ready while your vault remains unchronicled. Record your daily wages and outflows for review.'
                ];
                verdictEl.textContent = 'Status: Awaiting First Record';
                commentEl.textContent = pickRandom(emptyDialogues);
                return;
            }

            const totalInc = data.filter(r => r.type === 'income').reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
            const totalExp = data.filter(r => r.type === 'expense').reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
            const netBal = totalInc - totalExp;

            const expenseMap = {};
            data.filter(r => r.type === 'expense').forEach(e => {
                expenseMap[e.category] = (expenseMap[e.category] || 0) + (Number(e.amount) || 0);
            });

            let topExpenseCat = '';
            let maxExpenseVal = 0;
            for (const cat in expenseMap) {
                if (expenseMap[cat] > maxExpenseVal) {
                    maxExpenseVal = expenseMap[cat];
                    topExpenseCat = cat;
                }
            }

            if (totalInc === 0 && totalExp > 0) {
                const zeroIncomeDialogues = [
                    `By the Crown, you have disbursed $${totalExp.toFixed(2)} in silver without a single copper of wage inscribed. Even wealthy lords cannot live on thin air and goodwill.`,
                    `You disburse coin like a reckless aristocrat while recording zero incoming revenue. The workhouse awaits such careless domestic stewardship.`,
                    `Outflows of $${totalExp.toFixed(2)} and not one shilling earned. Seek honest trade or apprenticeship before the bailiffs knock upon your door.`
                ];
                verdictEl.textContent = pickRandom(['Status: Perilous Outflow', 'Status: Unfunded Spender', 'Status: Bleeding Coffers']);
                commentEl.textContent = pickRandom(zeroIncomeDialogues);
                return;
            }

            if (netBal < 0) {
                const deficitVal = Math.abs(netBal).toFixed(2);
                const deficitDialogues = [
                    `A grievous domestic deficit. Your expenses exceed earnings by $${deficitVal}. Tighten your purse strings before your creditors demand your silver spoons.`,
                    `Your balance sinks into negative territory by $${deficitVal}. One does not maintain standing in polite society by outspending one station.`,
                    `A deficit of $${deficitVal} is a direct carriage ride toward financial ruin. Cease non-essential disbursements on ${topExpenseCat || 'frivolities'} immediately.`,
                    `Disaster looms over your household accounts with $${deficitVal} in deficit. Severe domestic austerity is now firmly commanded.`
                ];
                verdictEl.textContent = pickRandom(['Status: Hazardous Deficit', 'Status: Overdrawn Estate', 'Status: Solvent Crisis']);
                commentEl.textContent = pickRandom(deficitDialogues);
                return;
            }

            const savingsRatio = totalInc > 0 ? (netBal / totalInc) : 0;
            const pct = (savingsRatio * 100).toFixed(0);

            if (savingsRatio >= 0.60) {
                const highSavingsDialogues = [
                    `A masterclass in Victorian thrift. You have preserved ${pct} percent of your gold. The Bank of England itself would commend such steadfast fortitude.`,
                    `A counting-house masterwork. With ${pct} percent of wages retained, your estate stands firmly fortified against any financial panic.`,
                    `Splendid restraint and sovereign discipline. You hoard coin like a master banker preparing for industrial empire.`,
                    `Few gentlemen in London possess such iron will over their purses. Your vault swells with ${pct} percent of all wages earned.`
                ];
                verdictEl.textContent = pickRandom(['Status: Master of Imperial Thrift', 'Status: Sovereign Capitalist', 'Status: Iron Banker']);
                commentEl.textContent = pickRandom(highSavingsDialogues);
                return;
            }

            if (savingsRatio >= 0.25) {
                const categoryNotes = {
                    'Leisure & Luxuries': 'Your taste for evening pleasures and tobacco takes notable coin, though your surplus holds.',
                    'Provisions & Sustenance': 'The kitchen and provisioner claim significant silver, though your accounts remain sound.',
                    'Lodging & Hearth': 'Heavier coal and domestic hearth dues than average, but your balance remains in good health.',
                    'Apparel & Tailoring': 'Your tailor has received handsome sums, yet your treasury maintains respectable order.'
                };

                const specificNote = categoryNotes[topExpenseCat] || `Your funds move with disciplined cadence, retaining a comfortable $${netBal.toFixed(2)} reserve.`;
                const moderateDialogues = [
                    `A respectable showing for a prudent household. Your ledger retains ${pct} percent of earnings in steady reserve. ${specificNote}`,
                    `Sound domestic economics. You maintain a solid cushion of $${netBal.toFixed(2)} while meeting all household obligations with dignity.`,
                    `Your accounts demonstrate commendable Victorian balance. Continue this trajectory and your future shall remain secure.`
                ];
                verdictEl.textContent = pickRandom(['Status: Prudent Gentleman', 'Status: Disciplined Estate', 'Status: Sound Household']);
                commentEl.textContent = pickRandom(moderateDialogues);
                return;
            }

            const narrowDialogues = [
                `You walk a razor-thin tightrope with barely ${pct} percent of your coin spared. A sudden coach breakdown or physician bill could plunge your vault into debt.`,
                `Living within inches of your total income. Seek greater margin before the arrival of harsh winter expenditures.`,
                `Your earnings and expenditures run neck and neck. A single unforeseen domestic mishap will thrust your ledger into deficit.`
            ];
            verdictEl.textContent = pickRandom(['Status: Narrow Margins', 'Status: Tightrope Accounts', 'Status: Fragile Equilibrium']);
            commentEl.textContent = pickRandom(narrowDialogues);
        }

        const homeScreen = document.getElementById('homeScreen');
        const dashboardScreen = document.getElementById('dashboardScreen');
        const navHomeBtn = document.getElementById('navHomeBtn');
        const navDashBtn = document.getElementById('navDashBtn');
        const enterDashBtn = document.getElementById('enterDashBtn');

        const tabIncome = document.getElementById('tabIncome');
        const tabExpense = document.getElementById('tabExpense');
        const entryDescInput = document.getElementById('entryDesc');
        const entryDateInput = document.getElementById('entryDate');
        const entryForm = document.getElementById('entryForm');
        const aiCategoryPreview = document.getElementById('aiCategoryPreview');

        const filterType = document.getElementById('filterType');
        const searchFilter = document.getElementById('searchFilter');
        const registryBody = document.getElementById('registryBody');

        const editModal = document.getElementById('editModal');
        const editForm = document.getElementById('editForm');
        const editDescInput = document.getElementById('editDesc');
        const editAiCategoryPreview = document.getElementById('editAiCategoryPreview');
        const cancelEditBtn = document.getElementById('cancelEditBtn');

        const confirmModal = document.getElementById('confirmModal');
        const confirmPurgeBtn = document.getElementById('confirmPurgeBtn');
        const cancelPurgeBtn = document.getElementById('cancelPurgeBtn');
        const reAuditBtn = document.getElementById('reAuditBtn');

        function updateAIPreview() {
            if (aiCategoryPreview && entryDescInput) {
                const detected = determineAICategory(entryDescInput.value, currentType);
                aiCategoryPreview.textContent = `AI Category: ${detected}`;
            }
        }

        if (entryDescInput) {
            entryDescInput.addEventListener('input', updateAIPreview);
        }

        if (reAuditBtn) {
            reAuditBtn.onclick = function() {
                generateAICommentary(registryData);
                showToast('The Comptroller has re-evaluated your accounts.');
            };
        }

        function showToast(message) {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = 'toast-message';
            toast.innerHTML = `<span class="gold-diamond"></span> ${escapeHTML(message)}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }

        function escapeHTML(str) {
            return String(str || '').replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
        }

        function switchScreen(target) {
            try {
                if (target === 'home') {
                    homeScreen.classList.add('active');
                    dashboardScreen.classList.remove('active');
                    navHomeBtn.classList.add('active');
                    navDashBtn.classList.remove('active');
                } else {
                    homeScreen.classList.remove('active');
                    dashboardScreen.classList.add('active');
                    navDashBtn.classList.add('active');
                    navHomeBtn.classList.remove('active');
                    
                    renderRegistry();
                    initOrUpdateCharts();
                }
            } catch (err) {}
        }

        if (navHomeBtn) navHomeBtn.onclick = function() { switchScreen('home'); };
        if (navDashBtn) navDashBtn.onclick = function() { switchScreen('dash'); };
        if (enterDashBtn) enterDashBtn.onclick = function() { switchScreen('dash'); };

        if (entryDateInput) {
            entryDateInput.value = new Date().toISOString().split('T')[0];
        }

        if (tabIncome) {
            tabIncome.onclick = function() {
                currentType = 'income';
                tabIncome.classList.add('active');
                if (tabExpense) tabExpense.classList.remove('active');
                updateAIPreview();
            };
        }

        if (tabExpense) {
            tabExpense.onclick = function() {
                currentType = 'expense';
                tabExpense.classList.add('active');
                if (tabIncome) tabIncome.classList.remove('active');
                updateAIPreview();
            };
        }

        if (entryForm) {
            entryForm.onsubmit = function(e) {
                e.preventDefault();
                const amountInput = document.getElementById('entryAmount');
                const amountVal = parseFloat(amountInput ? amountInput.value : 0);
                if (isNaN(amountVal) || amountVal <= 0) {
                    showToast('Please specify a valid sum of coin.');
                    return;
                }

                const rawDesc = entryDescInput ? entryDescInput.value.trim() : '';
                const aiCategory = determineAICategory(rawDesc, currentType);

                const newRecord = {
                    id: Date.now(),
                    desc: rawDesc || aiCategory,
                    category: aiCategory,
                    amount: amountVal,
                    date: entryDateInput ? entryDateInput.value : new Date().toISOString().split('T')[0],
                    type: currentType
                };

                registryData.unshift(newRecord);
                saveAndRefresh();
                entryForm.reset();
                if (entryDateInput) entryDateInput.value = new Date().toISOString().split('T')[0];
                updateAIPreview();
                showToast(`Inscribed and categorized as ${aiCategory}.`);
            };
        }

        let currentEditingRecord = null;

        function openEditModal(id) {
            const record = registryData.find(r => r.id === id);
            if (!record) return;

            currentEditingRecord = record;
            document.getElementById('editId').value = record.id;
            editDescInput.value = record.desc || '';
            document.getElementById('editAmount').value = record.amount;
            document.getElementById('editDate').value = record.date;
            
            const cat = determineAICategory(record.desc, record.type);
            editAiCategoryPreview.textContent = `AI Category: ${cat}`;

            editModal.classList.add('active');
        }

        if (editDescInput) {
            editDescInput.oninput = function() {
                if (currentEditingRecord) {
                    const cat = determineAICategory(editDescInput.value, currentEditingRecord.type);
                    editAiCategoryPreview.textContent = `AI Category: ${cat}`;
                }
            };
        }

        if (cancelEditBtn) {
            cancelEditBtn.onclick = function() {
                editModal.classList.remove('active');
            };
        }

        if (editForm) {
            editForm.onsubmit = function(e) {
                e.preventDefault();
                const id = parseInt(document.getElementById('editId').value, 10);
                const recordIndex = registryData.findIndex(r => r.id === id);
                
                if (recordIndex !== -1) {
                    const rec = registryData[recordIndex];
                    const rawDesc = editDescInput.value.trim();
                    const aiCategory = determineAICategory(rawDesc, rec.type);

                    rec.desc = rawDesc || aiCategory;
                    rec.category = aiCategory;
                    rec.amount = parseFloat(document.getElementById('editAmount').value);
                    rec.date = document.getElementById('editDate').value;
                    
                    saveAndRefresh();
                    editModal.classList.remove('active');
                    showToast('Record amendments saved.');
                }
            };
        }

        const clearAllBtn = document.getElementById('clearAllBtn');
        if (clearAllBtn) {
            clearAllBtn.onclick = function() {
                confirmModal.classList.add('active');
            };
        }

        if (cancelPurgeBtn) {
            cancelPurgeBtn.onclick = function() {
                confirmModal.classList.remove('active');
            };
        }

        if (confirmPurgeBtn) {
            confirmPurgeBtn.onclick = function() {
                registryData = [];
                saveAndRefresh();
                confirmModal.classList.remove('active');
                showToast('Ledger completely purged.');
            };
        }

        const exportCsvBtn = document.getElementById('exportCsvBtn');
        if (exportCsvBtn) {
            exportCsvBtn.onclick = function() {
                if (!registryData || registryData.length === 0) {
                    showToast('No records available to export.');
                    return;
                }
                let csv = 'ID,Type,Particulars,AI_Category,Date,Amount\n';
                registryData.forEach(r => {
                    csv += `${r.id},${r.type},"${(r.desc || '').replace(/"/g, '""')}","${r.category}",${r.date},${r.amount}\n`;
                });
                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `ledger_records_${new Date().toISOString().slice(0,10)}.csv`;
                link.click();
                showToast('CSV ledger exported.');
            };
        }

        if (registryBody) {
            registryBody.onclick = function(e) {
                const editBtn = e.target.closest('.edit-link');
                const deleteBtn = e.target.closest('.delete-link');

                if (editBtn) {
                    const id = parseInt(editBtn.dataset.id, 10);
                    openEditModal(id);
                } else if (deleteBtn) {
                    const id = parseInt(deleteBtn.dataset.id, 10);
                    registryData = registryData.filter(r => r.id !== id);
                    saveAndRefresh();
                    showToast('Entry stricken from the registry.');
                }
            };
        }

        let expenseChartInst = null;
        let cashflowChartInst = null;

        function initOrUpdateCharts() {
            if (typeof Chart === 'undefined') return;

            try {
                const chartFont = { family: "'Playfair Display', Georgia, serif", size: 12 };
                const expenses = registryData.filter(r => r.type === 'expense');
                const catMap = {};
                expenses.forEach(e => { catMap[e.category] = (catMap[e.category] || 0) + Number(e.amount); });

                const canvasExp = document.getElementById('expenseChart');
                const noticeExp = document.getElementById('expenseEmptyNotice');

                if (expenses.length === 0) {
                    if (noticeExp) noticeExp.style.display = 'block';
                } else {
                    if (noticeExp) noticeExp.style.display = 'none';
                }

                const labels = Object.keys(catMap);
                const dataValues = Object.values(catMap);
                const vibrantColors = ['#c92a2a', '#087f5b', '#d97706', '#7950f2', '#1c7ed6', '#e8590c', '#20c997'];

                if (!expenseChartInst && canvasExp) {
                    const ctxExp = canvasExp.getContext('2d');
                    expenseChartInst = new Chart(ctxExp, {
                        type: 'doughnut',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: dataValues,
                                backgroundColor: labels.map((_, i) => vibrantColors[i % vibrantColors.length]),
                                borderWidth: 2,
                                borderColor: '#fdf6e7'
                            }]
                        },
                        options: { 
                            responsive: true, 
                            maintainAspectRatio: false, 
                            plugins: { 
                                legend: { display: false },
                                tooltip: {
                                    titleFont: chartFont,
                                    bodyFont: chartFont,
                                    backgroundColor: '#1f1207',
                                    borderColor: '#c59325',
                                    borderWidth: 1,
                                    callbacks: { label: (ctx) => ` $${Number(ctx.raw).toFixed(2)}` }
                                }
                            }, 
                            cutout: '62%' 
                        }
                    });
                } else if (expenseChartInst) {
                    expenseChartInst.data.labels = labels;
                    expenseChartInst.data.datasets[0].data = dataValues;
                    expenseChartInst.data.datasets[0].backgroundColor = labels.map((_, i) => vibrantColors[i % vibrantColors.length]);
                    expenseChartInst.update();
                }

                const totalInc = registryData.filter(r => r.type === 'income').reduce((sum, r) => sum + Number(r.amount), 0);
                const totalExp = registryData.filter(r => r.type === 'expense').reduce((sum, r) => sum + Number(r.amount), 0);
                const canvasCash = document.getElementById('cashflowChart');

                if (!cashflowChartInst && canvasCash) {
                    const ctxCash = canvasCash.getContext('2d');
                    cashflowChartInst = new Chart(ctxCash, {
                        type: 'bar',
                        data: {
                            labels: ['Treasury Flow'],
                            datasets: [
                                { label: 'Inflows', data: [totalInc], backgroundColor: '#087f5b', borderRadius: 3 },
                                { label: 'Outflows', data: [totalExp], backgroundColor: '#c92a2a', borderRadius: 3 }
                            ]
                        },
                        options: { 
                            responsive: true, 
                            maintainAspectRatio: false, 
                            plugins: { 
                                legend: { display: false },
                                tooltip: {
                                    titleFont: chartFont,
                                    bodyFont: chartFont,
                                    backgroundColor: '#1f1207',
                                    borderColor: '#c59325',
                                    borderWidth: 1,
                                    callbacks: { label: (ctx) => ` ${ctx.dataset.label}: $${Number(ctx.raw).toFixed(2)}` }
                                }
                            }, 
                            scales: { 
                                x: { grid: { display: false } }, 
                                y: { grid: { color: 'rgba(197, 147, 37, 0.2)' }, ticks: { font: chartFont } } 
                            } 
                        }
                    });
                } else if (cashflowChartInst) {
                    cashflowChartInst.data.datasets[0].data = [totalInc];
                    cashflowChartInst.data.datasets[1].data = [totalExp];
                    cashflowChartInst.update();
                }
            } catch (err) {}
        }

        function renderRegistry() {
            try {
                const totalInc = registryData.filter(r => r.type === 'income').reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
                const totalExp = registryData.filter(r => r.type === 'expense').reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
                const netBal = totalInc - totalExp;

                const incEl = document.getElementById('totalIncome');
                const expEl = document.getElementById('totalExpense');
                const balEl = document.getElementById('totalBalance');

                if (incEl) incEl.textContent = `$${totalInc.toFixed(2)}`;
                if (expEl) expEl.textContent = `$${totalExp.toFixed(2)}`;
                if (balEl) {
                    let minusPrefix = '';
                    if (netBal < 0) {
                        minusPrefix = '-';
                        balEl.style.color = 'var(--accent-red)';
                    } else {
                        balEl.style.color = 'var(--ink-main)';
                    }
                    balEl.textContent = `${minusPrefix}$${Math.abs(netBal).toFixed(2)}`;
                }

                generateAICommentary(registryData);

                let searchKeyword = '';
                if (searchFilter) searchKeyword = searchFilter.value.toLowerCase().trim();
                
                let filterTypeVal = 'all';
                if (filterType) filterTypeVal = filterType.value;

                let filtered = registryData.filter(r => {
                    const matchesType = (filterTypeVal === 'all' || r.type === filterTypeVal);
                    const descText = (r.desc || '').toLowerCase();
                    const catText = (r.category || '').toLowerCase();
                    const matchesSearch = !searchKeyword || descText.includes(searchKeyword) || catText.includes(searchKeyword);
                    return matchesType && matchesSearch;
                });

                const countEl = document.getElementById('recordCount');
                if (countEl) countEl.textContent = `${filtered.length} of ${registryData.length} records shown`;
                
                if (registryBody) {
                    registryBody.innerHTML = '';
                    if (filtered.length === 0) {
                        registryBody.innerHTML = `<tr><td colspan="5" class="empty-registry">No matching transactions inscribed in this view.</td></tr>`;
                    } else {
                        filtered.forEach(r => {
                            const tr = document.createElement('tr');
                            let sign = '-';
                            if (r.type === 'income') {
                                sign = '+';
                            }
                            tr.innerHTML = `
                                <td style="white-space: nowrap;">${escapeHTML(r.date)}</td>
                                <td><strong>${escapeHTML(r.desc)}</strong></td>
                                <td><span class="category-badge">${escapeHTML(r.category)}</span></td>
                                <td class="amount-col ${r.type}">${sign}$${Math.abs(Number(r.amount) || 0).toFixed(2)}</td>
                                <td style="white-space: nowrap;">
                                    <button type="button" class="action-btn edit-link" data-id="${r.id}">Amend</button>
                                    <button type="button" class="action-btn delete-link" data-id="${r.id}">Strike Out</button>
                                </td>
                            `;
                            registryBody.appendChild(tr);
                        });
                    }
                }
            } catch (err) {}
        }

        function saveAndRefresh() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(registryData));
            } catch (e) {}
            renderRegistry();
            initOrUpdateCharts();
        }

        if (filterType) filterType.onchange = renderRegistry;
        if (searchFilter) searchFilter.oninput = renderRegistry;

        updateAIPreview();
        renderRegistry();
    </script>
</body>
</html>
